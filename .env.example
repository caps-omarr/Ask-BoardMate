# E-BoardMate Generative AI RAG Layer Environment Variables
# Copy this file to .env and set your Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face Access Token (Optional for dense vector embedding models)
HF_TOKEN=your_huggingface_token_here

# Production Database Connection (Optional for live MySQL export)
DB_HOST=eboardmate.onrender.com
DB_PORT=3306
DB_DATABASE=eboardmate_db
DB_USERNAME=eboard_user
DB_PASSWORD=your_db_password
